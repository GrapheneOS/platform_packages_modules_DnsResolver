package {
    default_team: "trendy_team_fwk_core_networking",
}

genrule {
    name: "libdns_proxy_cxx_bridge_header",
    tools: ["cxxbridge"],
    cmd: "$(location cxxbridge) $(in) --header >> $(out)",
    srcs: ["src/dns_proxy/ffi.rs"],
    out: ["dns_proxy_cxx_bridge.rs.h"],
}

genrule {
    name: "libdns_proxy_cxx_bridge_source",
    tools: ["cxxbridge"],
    cmd: "$(location cxxbridge) $(in) >> $(out)",
    srcs: ["src/dns_proxy/ffi.rs"],
    out: ["dns_proxy_cxx_bridge.rs.cpp"],
}

rust_defaults {
    name: "resolvrs_defaults",
    crate_name: "resolvrs",
    edition: "2021",
    srcs: ["src/lib.rs"],
    features: ["statslog"],

    rlibs: [
        "libandroid_logger",
        "libcxx",
        "libanyhow",
        "libbytes",
        "libfutures",
        "liblog_rust",
        "libnix",
        "libnum_enum",
        "librand",
        "libsocket2",
        "libthiserror",
        "libtokio",
        "libbase64_rust",
        "liblibc",
        "libring",
        "librustutils",
        "libstatslog_dns_resolver_rust",
        "liburl",
    ],
    shared_libs: [
        "libcrypto",
        "libssl",
    ],
}

rust_ffi_static {
    name: "libresolvrs_ffi",
    defaults: ["resolvrs_defaults"],
    features: ["android-ffi"],
    prefer_rlib: true,
    rlibs: [
        "libcxx",
        "libquiche",
    ],
    shared_libs: [
        "libcrypto",
        "libssl",
    ],
    apex_available: ["com.android.resolv"],
    min_sdk_version: "30",
}

rust_ffi_static {
    name: "libresolvrs_test_ffi",
    defaults: ["resolvrs_defaults"],
    features: ["android-ffi"],
    prefer_rlib: true,
    rlibs: [
        "libcxx",
        "libquiche_static",
    ],
    shared_libs: [
        "libstatssocket",
    ],
    apex_available: [
        "apex_available:platform",
        "com.android.resolv",
    ],
    min_sdk_version: "30",
}

rust_test {
    name: "resolvrs_unit_test",
    defaults: ["resolvrs_defaults"],
    test_suites: ["general-tests"],

    rlibs: [
        "libquiche_static",
        "libmockall",
    ],
    shared_libs: ["libc++"],
    min_sdk_version: "30",
}
